{
  "name": "promptly-ai-backend",
  "version": "0.2.0",
  "description": "Promptly AI backend — Express + Firebase Firestore + Firebase Auth. Marketplace for AI prompts with subscriptions, paid unlocks, and creator payouts (Razorpay). Deploys to Cloud Run.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:seed": "node src/db/seed.js",
    "test": "node --test"
  },
  "dependencies": {
    "@google-cloud/vision": "^6.0.0",
    "adm-zip": "^0.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.1",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "razorpay": "^2.9.8",
    "sharp": "^0.35.3",
    "zod": "^3.24.1"
  }
}
