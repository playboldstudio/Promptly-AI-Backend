# ── Firebase / Firestore ─────────────────────────────────────────────────────
# The datastore. FIREBASE_PROJECT_ID is the only strictly-required var.
FIREBASE_PROJECT_ID="your-gcp-project-id"

# Preferred (production): a service-account private key. On Cloud Run use Google
# Secret Manager and reference it via `--set-env-vars` / `--set-secrets`. The
# private key contains literal newlines — JSON-escape them (\\n) when passing via
# env, or mount the service-account JSON with GOOGLE_APPLICATION_CREDENTIALS.
# FIREBASE_CLIENT_EMAIL="your-sa@your-project.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Alt: path to a service-account JSON file (same as GOOGLE_APPLICATION_CREDENTIALS).
# On Cloud Run the default service account is used automatically when unset.
# GOOGLE_APPLICATION_CREDENTIALS="/app/gcp-key.json"

# Google Cloud Storage bucket for uploaded prompt images (only if you add uploads).
# STORAGE_BUCKET="your-project.appspot.com"

# ── Server ────────────────────────────────────────────────────────────────────
# Cloud Run injects PORT; 8080 is the conventional default.
PORT=8080
NODE_ENV=development

# ── Google Play Billing (payments) ────────────────────────────────────────────
# The Android package name — required for /payments/playbilling/* verify calls.
# Auth uses the same Google creds as Firestore (ADC / service account).
# PLAY_BILLING_PACKAGE_NAME=com.promptlyai.app
# RTDN (Real-Time Developer Notifications) subscription id from Cloud Pub/Sub.
# RTDN_SUBSCRIPTION=play-billing-rtdn-sub

# ── Deploy / URLs ─────────────────────────────────────────────────────────────
# The Cloud Run HTTPS URL, e.g. https://promptly-ai-backend-<hash>.run.app
# The Android/Web client and CORS allow-list use this. See src/config/urls.js.
# PUBLIC_BASE_URL=https://promptly-ai-backend-<hash>.run.app
# Extra browser origins CORS should allow (comma-separated). The live API URL is
# always allowed. Add a web frontend dev server here if needed, e.g.:
# CORS_ORIGINS=http://localhost:8081

# ── Admin (payout back-office) ────────────────────────────────────────────────
# Comma-separated emails allowed to use /payments/admin/* (approve/settle payouts).
# Leave empty to disable all admin endpoints.
# ADMIN_EMAILS=you@promptly.app

# ── Payouts ───────────────────────────────────────────────────────────────────
# Minimum amount (rupees) a creator can withdraw. Default 60.
# MIN_WITHDRAWAL_INR=60
# Withdrawal fee is the seller's platform fee % (Pro=15%, Creator=5%,
# configurable in the subscription_plans seed). No gateway fee is deducted at
# payout — Play Billing's commission is absorbed by the platform at payment time.

# ── Deposits & Bonus ─────────────────────────────────────────────────────────
# Deposit packs: deposit_s (₹10), deposit_m (₹100), deposit_l (₹500), deposit_xl (₹1000).
# Gateway fee (~15%) is recycled as bonus credit (FEFO, 90-day expiry).
# DEPOSIT_MIN_INR=10
# DEPOSIT_MAX_INR=10000
# BONUS_EXPIRY_DAYS=90
# PLAY_BILLING_FEE_TOLERANCE_INR=0.01

# ── Secrets to keep OUT of the repo (set via Secret Manager / Cloud Run) ──────
#   FIREBASE_CLIENT_EMAIL
#   FIREBASE_PRIVATE_KEY
