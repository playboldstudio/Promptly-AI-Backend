# ---- Database ----
# Hosted PostgreSQL (Neon / Supabase / Railway / RDS). Paste your connection string.
# `sslmode=require` is recommended for hosted providers (Neon/Supabase need it).
DATABASE_URL="postgresql://user:password@host:5432/promptly?sslmode=require"

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Razorpay (payments) ----
# Get keys from dashboard.razorpay.com → Settings → API Keys.
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...   # Settings → Webhooks
# Razorpay Subscription Plan IDs — create the plans in the dashboard (Settings → Plans),
# then map them here by our plan id. Required for /payments/subscriptions.
# RAZORPAY_PLAN_PRO_ID=plan_xxx
# RAZORPAY_PLAN_CREATOR_ID=plan_xxx

# ---- Auth (future) ----
# Swap point for Firebase / Supabase auth. Leave blank while using /auth/dev/login.
# AUTH_PROVIDER=firebase
# FIREBASE_PROJECT_ID=...
